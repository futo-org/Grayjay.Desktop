FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends gcc-mingw-w64-x86-64 g++-mingw-w64-x86-64 python3 python3-pip python3-venv ninja-build pkg-config make xz-utils bzip2 build-essential ca-certificates git && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/build-python && /opt/build-python/bin/pip install meson==1.9.1
ENV PATH="/opt/build-python/bin:${PATH}"
ENV PKG_CONFIG_LIBDIR="/deps/mingw64/lib/pkgconfig"
ENV PKG_CONFIG_SYSROOT_DIR="/deps"
CMD ["bash","/build-qemu.sh"]
