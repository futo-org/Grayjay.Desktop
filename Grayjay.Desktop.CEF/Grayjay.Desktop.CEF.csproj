<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>WinExe</OutputType>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64;linux-x64;linux-arm;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <AssemblyName>Grayjay</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>False</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CEFWindow.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'osx-x64' And '$(RuntimeIdentifier)' != 'osx-x64'">
    <None Remove="Portable" />
    <Compile Include="Portable">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="grayjay.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ContentWithTargetPath Include="steam_appid.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>cef/steam_appid.txt</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="libsodium" Version="1.0.20" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-arm64" Version="7.4.5" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.4.5" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-x64" Version="7.4.5" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-arm64" Version="7.4.5" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-x64" Version="7.4.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JustCef\cs\JustCef.csproj" />
    <ProjectReference Include="..\Grayjay.ClientServer\Grayjay.ClientServer.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <PlaybackRuntimeId>$(RuntimeIdentifier)</PlaybackRuntimeId>
    <PlaybackRuntimeId Condition="'$(RuntimeIdentifier)' == 'win-arm64'">win-x64</PlaybackRuntimeId>
    <BundlePlayback Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-arm64' Or '$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64'">true</BundlePlayback>
    <PlaybackDependencyRoot>$(MSBuildProjectDirectory)/../Grayjay.ClientServer/deps/playback</PlaybackDependencyRoot>
    <PlaybackGuestExcludes>$(PlaybackDependencyRoot)/guest/vmlinuz</PlaybackGuestExcludes>
  </PropertyGroup>
  <ItemGroup Condition="'$(BundlePlayback)' == 'true'">
    <Content Condition="'$(PlaybackRuntimeId)' != 'win-x64'" Include="$(PlaybackDependencyRoot)/runtimes/$(PlaybackRuntimeId)/**/*">
      <Link>playback/runtime/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Condition="'$(PlaybackRuntimeId)' == 'win-x64'" Include="$(PlaybackDependencyRoot)/runtimes/win-x64/blink.exe;$(PlaybackDependencyRoot)/runtimes/win-x64/cygwin1.dll;$(PlaybackDependencyRoot)/runtimes/win-x64/blink-runtime.json">
      <Link>playback/runtime/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Condition="'$(PlaybackRuntimeId)' == 'win-x64'" Include="$(PlaybackDependencyRoot)/runtimes/win-x64/licenses/blink/**/*">
      <Link>playback/runtime/licenses/blink/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="$(PlaybackDependencyRoot)/guest/**/*" Exclude="$(PlaybackGuestExcludes)">
      <Link>playback/guest/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
  <Target Name="ValidateBundledPlayback" BeforeTargets="PrepareForBuild" Condition="'$(BundlePlayback)' == 'true'">
    <Error Condition="!Exists('$(PlaybackDependencyRoot)/guest/bundle.json')" Text="Linux playback guest is missing. Fetch Git LFS dependencies before building." />
    <Error Condition="'$(PlaybackRuntimeId)' != 'win-x64' And !Exists('$(PlaybackDependencyRoot)/runtimes/$(PlaybackRuntimeId)/blink-runtime.json')" Text="Blink playback runtime is missing. Fetch Git LFS dependencies before building." />
    <Error Condition="'$(PlaybackRuntimeId)' == 'win-x64' And !Exists('$(PlaybackDependencyRoot)/runtimes/win-x64/blink-runtime.json')" Text="Blink playback runtime is missing. Fetch Git LFS dependencies before building." />
  </Target>
</Project>
